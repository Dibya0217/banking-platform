# Copy this file to .env and fill in your values
# Never commit .env to git

# PostgreSQL
POSTGRES_USER=banking
POSTGRES_PASSWORD=your_secure_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# MinIO (S3-compatible storage)
MINIO_USER=minioadmin
MINIO_PASSWORD=your_minio_password_here

# Grafana
GRAFANA_PASSWORD=your_grafana_password_here

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your_256_bit_base64_encoded_secret_here

# Email (SMTP via MailHog for local dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Twilio SMS (use test credentials for dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Encryption key for PII (generate with: openssl rand -base64 32)
AES_ENCRYPTION_KEY=your_32_byte_base64_key_here
